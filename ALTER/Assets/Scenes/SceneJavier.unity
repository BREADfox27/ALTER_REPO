--- !u!114 &1441495776
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1441495774}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8a6828637c11124c9c0472321e9dcb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 2072363438}
  lines:
  - "Detevtive: Carlo, I\u2019m Detective Hughes. I need to ask you a few questions
    about Walter."
  - 'Carlo: Sure.'
  - 'Detective: You were owed a lot of money by the victim.'
  - "Carlo: That\u2019s true, enough to be annoying."
  - 'Detective: Annoying enough to stab him to death?'
  - 'Carlo: If I killed every person who owed me money, this city would be empty.'
  - 'Detective: What a fascinating answer.'
  - 'Carlo: You asked.'
  - 'Detective: When was the last time you saw Walter?'
  - 'Carlo: Yesterday afternoon.'
  - 'Detective: What happened?'
  - 'Carlo: I asked for my money. He told me he needed more time.'
  - 'Detective: Did the conversation get heated?'
  - "Carlo: A little. He yelled. I yelled. That\u2019s it."
  - 'Detective: Residents reported hearing threats.'
  - 'Carlo: People exaggerate.'
  - 'Detective: Did you threaten him?'
  - "Carlo: I told him debts don\u2019t disappear into thin air."
  - 'Detective: Sounds threatening to me.'
  - 'Carlo: Depends how sensitive you are.'
  - 'Detective: Walter was stabbed multiple times and stuffed into a trashcan. Most
    people would be at least a little disturbed.'
  - 'Carlo: Should I pretend to be?'
  - 'Detective: No. I just find your attitude interesting.'
  - "Carlo: You can find whatever you want, detective. Doesn\u2019t make me a killer."
  - 'Detective: You had motive, no alibi, and witnesses heard you threatening the
    victim. Until we prove otherwise, you remain a suspect.'
  - "*Carlo\u2019s profile has been added to your suspects folder*."
  textSpeed: 0.05
