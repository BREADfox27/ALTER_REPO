  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 1901448249}
  lines:
  - 'Cop: The victim here was Walter, a 73-year-old male. He was found inside the
    trashcan with multiple stab wounds. The knife has not been found.'
  - Our suspects are Carlo, a man who he owed a lot of money to, and Gertrude, his
    wife. The murder happened around midnight and there was no one around.
  - "*Walter\u2019s profile has been added to your victims folder*."
  textSpeed: 0.05
