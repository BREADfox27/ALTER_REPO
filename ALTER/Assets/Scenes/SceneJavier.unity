--- !u!114 &154297516
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 154297514}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8a6828637c11124c9c0472321e9dcb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 2084043394}
  lines:
  - "Detective: I\u2019m done reviewing the cases. Both of them still seem suspicious.
    Tell me, does Gertrude have any history of mental illness?"
  - "Cop: Actually, I forgot to mention that. She\u2019s been diagnosed with bipolar
    disorder and dissociative identity disorder."
  - "According to the nurses, they\u2019ve identified three personalities so far:
    her usual self, Gertrude; a rude, bratty personality named Jenny;"
  - and a childlike, innocent one called Lily.
  - "Detective: Well, that makes sense. Got any news on Rose\u2019s phone?"
  - 'Cop: Yes, there was nothing out of the ordinary.'
  - 'Detective: Ok, thanks for the update.'
  - "Cop: No problem. We\u2019ve finally investigated all 3 cases. We didn\u2019t
    get any conclusions yet. It\u2019s up to you to solve this."
  - "Detective: I\u2019m ready to share my deduction.\u201D"
  textSpeed: 0.05
