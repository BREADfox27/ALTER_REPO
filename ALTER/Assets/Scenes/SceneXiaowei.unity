  m_Script: {fileID: 11500000, guid: a8a6828637c11124c9c0472321e9dcb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 1455653568}
  lines:
  - 'Detective: He denies the accusations.'
  - He has to be taken into custody and you have to figure out if the candy contained
    any substance and interrogate the children about him.
  - "Cop: Got it. While my subordinates take care of that, we can head over to Willow
    Boutique at the mall. That\u2019s where the second corpse has been found."
  - I will tell you more about it when we get there.
  - "Detective: Let\u2019s get going then."
  textSpeed: 0.05
