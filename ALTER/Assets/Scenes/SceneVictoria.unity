--- !u!114 &1669149306
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1669149304}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8a6828637c11124c9c0472321e9dcb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 1498740093}
  lines:
  - "Detective: Bryan, I\u2019m Detective Hughes. I\u2019m going to need to speak
    with you for a moment."
  - 'Bryan: Ok.'
  - "Detective: You were detained for stealing in this store yesterday. One of the
    items was the victim\u2019s gold necklace. Anything to say about that?"
  - "Bryan: Nah, not really. I\u2019m innocent. I know nothing about that."
  - "Detective: We\u2019re talking about a murder here. I need you to be more serious."
  - "Bryan: Ok man, relax. I\u2019m telling you; I didn\u2019t steal from her or
    kill her."
  - 'Detective: Then why did you have the necklace on you?'
  - "Bryan: I don\u2019t know. Maybe someone else put it there."
  - 'Detective: Like who?'
  - "Bryan: Maybe it was that girl over there, she was there when I was and she\u2019s
    kind of weird."
  - "Detective: That\u2019s a bold claim."
  - "Bryan: I mean, she\u2019s the only other suspect, so who else then?"
  - "Detective: Seems like you\u2019re shifting the blame."
  - "Bryan: I swear on my life man, it wasn\u2019t me."
  - "Detective: We\u2019ll see."
  - "*Bryan\u2019s profile has been added to your suspects folder*."
  textSpeed: 0.05
