--- !u!114 &1562124771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1562124767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8a6828637c11124c9c0472321e9dcb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 1029970298}
  lines:
  - 'Cop: The body discovered here today belonged to 13-year-old Chloe. She was found
    beneath a pile of clothes inside a fitting room, strangled with a shirt.'
  - 'We currently have two suspects: Rose, a 13-year-old girl who was frequently
    bullied by Chloe, and Bryan, a 23-year-old ex-convict with a history of theft
    who was detained at the'
  - "store yesterday for stealing, among the items he stole there was Chloe\u2019s
    necklace. Both were seen in the store around the estimated time of death."
  - "Detective: Got it. I\u2019ll go interrogate them."
  - "*Chloe\u2019s profile has been added to your victims folder*."
  textSpeed: 0.05
