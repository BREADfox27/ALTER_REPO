  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8a6828637c11124c9c0472321e9dcb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  dialogueText: {fileID: 1162186184}
  lines:
  - "Detective: I\u2019m done. Both suspects raise concerns. I\u2019ve confiscated
    the girl\u2019s phone; it should help narrow things down. I\u2019ll hand it over
    so your team can handle the analysis."
  - "Cop: That\u2019s fine. My team has already examined Jeff\u2019s candy. All normal."
  - But he still matches the behavioural profile, and he was seen attempting to approach
    the victim shortly before she disappeared.
  - "Detective: He\u2019s not completely clear yet."
  - "Cop: We still have the last case to go to. It\u2019s in the nursing home. I\u2019ll
    get into the details when we arrive."
  textSpeed: 0.05
